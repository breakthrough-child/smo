# Copy to .env.local and fill in. Never commit real values.

# Anthropic — server only
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy "anon" key. Safe in the browser: RLS has no public policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or the legacy "service_role" key. Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: the ID of a published guide shown by "See an example guide" on the landing page
# (the part after /g/ in a tour link). Leave empty to hide the button. Redeploy after changing it.
NEXT_PUBLIC_DEMO_GUIDE_ID=
