# Copy to .env.local and fill in. Never commit real values.

# Anthropic — server only
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy "anon" key. Safe in the browser: RLS has no public policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or the legacy "service_role" key. Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
